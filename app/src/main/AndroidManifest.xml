<?xml version="1.0" encoding="utf-8"?>
<!-- On-device only: no network permission (D3). No backup (D9). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only calendar (D17, D21): no write permission. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Steps only, read-only (D1, D16). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- So the widget's 30-minute refresh can read steps (D26). Asked with READ_STEPS. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- On 28–33 Health Connect is a Play app: needed to check for it and to request access. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".PdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect's privacy rationale is the About screen (SPEC §5.3, PRD A9). 28–33: -->
        <activity
            android:name=".PrivacyRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- 34+: only the system may start it. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacyRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The one summary widget (SPEC §6.2, D2, D19). -->
        <receiver
            android:name=".widget.DashboardWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dashboard_widget_info" />
        </receiver>
    </application>

</manifest>
